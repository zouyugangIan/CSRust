[
  {
    "label": "Debug playground",
    "adapter": "CodeLLDB",
    "request": "launch",
    "cwd": "$ZED_WORKTREE_ROOT",
    "build": {
      "command": "cargo",
      "args": ["build", "--package", "playground", "--bin", "playground"],
      "cwd": "$ZED_WORKTREE_ROOT"
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/playground",
    "sourceLanguages": ["rust"]
  },
  {
    "label": "Debug current Rust example",
    "adapter": "CodeLLDB",
    "request": "launch",
    "cwd": "$ZED_WORKTREE_ROOT",
    "build": {
      "command": "cargo",
      "args": [
        "build",
        "--package",
        "$ZED_CUSTOM_RUST_PACKAGE",
        "--example",
        "$ZED_STEM"
      ],
      "cwd": "$ZED_WORKTREE_ROOT"
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/examples/$ZED_STEM",
    "sourceLanguages": ["rust"]
  },
  {
    "label": "Debug guessing_game",
    "adapter": "CodeLLDB",
    "request": "launch",
    "cwd": "$ZED_WORKTREE_ROOT",
    "build": {
      "command": "cargo",
      "args": ["build", "--package", "guessing_game", "--bin", "guessing_game"],
      "cwd": "$ZED_WORKTREE_ROOT"
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/guessing_game",
    "sourceLanguages": ["rust"]
  },
  {
    "label": "Debug todo_cli (list)",
    "adapter": "CodeLLDB",
    "request": "launch",
    "cwd": "$ZED_WORKTREE_ROOT",
    "build": {
      "command": "cargo",
      "args": ["build", "--package", "todo_cli", "--bin", "todo_cli"],
      "cwd": "$ZED_WORKTREE_ROOT"
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/todo_cli",
    "args": ["list"],
    "sourceLanguages": ["rust"]
  }
]
